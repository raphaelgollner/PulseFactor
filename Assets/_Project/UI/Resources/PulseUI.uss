/* PulseFactor HUD: cores frias com acentos quentes, sem esconder o espaco. */

.hud-root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: bold;
    color: rgb(200, 235, 245);
}

.label { font-size: 15px; color: rgb(200, 235, 245); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgba(0, 0, 0, 0.6); }
.label-small { font-size: 12px; color: rgb(150, 190, 205); }
.label-big { font-size: 26px; color: rgb(230, 250, 255); }
.label-warn { color: rgb(255, 170, 60); }
.label-bad { color: rgb(255, 90, 80); }

/* Barras de escudo / casco / combustivel */
.bars { position: absolute; left: 28px; top: 24px; width: 300px; }
.bar { height: 10px; margin-bottom: 6px; background-color: rgba(10, 20, 30, 0.55); border-width: 1px; border-color: rgba(120, 200, 230, 0.35); }
.bar-fill { height: 100%; }
.bar-shield { background-color: rgb(70, 170, 255); }
.bar-hull { background-color: rgb(240, 80, 70); }
.bar-fuel { background-color: rgb(255, 160, 40); }
.bar-boost { background-color: rgb(120, 255, 210); }

.credits { position: absolute; right: 28px; top: 24px; -unity-text-align: upper-right; }
.test-mode { position: absolute; right: 28px; top: 50px; color: rgb(255, 200, 60); font-size: 12px; }
.sector { position: absolute; left: 0; right: 0; top: 18px; -unity-text-align: upper-center; font-size: 14px; color: rgb(150, 210, 230); }

.alert { position: absolute; left: 0; right: 0; top: 44px; -unity-text-align: upper-center; font-size: 22px; color: rgb(255, 255, 255); background-color: rgba(190, 20, 20, 0.75); padding: 6px; }
.contracts { position: absolute; right: 28px; top: 90px; width: 460px; align-items: flex-end; }
.contract-line { font-size: 14px; color: rgb(220, 240, 250); background-color: rgba(10, 30, 40, 0.55); padding: 3px 8px; margin-bottom: 3px; border-right-width: 3px; border-color: rgb(255, 170, 60); -unity-text-align: middle-right; }
.welcome { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 8, 12, 0.85); }
.welcome-text { font-size: 42px; color: rgb(150, 230, 255); -unity-font-style: bold; }
.section-title { font-size: 17px; color: rgb(110, 220, 250); margin-top: 10px; margin-bottom: 4px; }
.contract-row { flex-direction: row; align-items: center; padding: 6px 4px; border-bottom-width: 1px; border-color: rgba(80, 160, 190, 0.25); }
.btn-danger { background-color: rgb(150, 50, 40); }
.btn-deliver { background-color: rgb(40, 150, 80); padding: 8px 18px; margin-top: 6px; align-self: flex-start; }
.route-marker { position: absolute; width: 16px; height: 16px; margin-left: -8px; margin-top: -8px; rotate: 45deg; background-color: rgba(170, 90, 255, 0.35); border-width: 2px; border-color: rgb(190, 110, 255); }
.route-label { color: rgb(205, 150, 255); }
.route-arrow { border-bottom-color: rgb(190, 110, 255); }

.map { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(2, 6, 12, 0.94); }
.map-title { position: absolute; left: 30px; top: 20px; font-size: 26px; color: rgb(150, 220, 250); -unity-font-style: bold; }
.map-hint { position: absolute; left: 30px; top: 56px; font-size: 14px; color: rgb(130, 170, 190); }
.map-canvas { position: absolute; left: 0; top: 70px; right: 380px; bottom: 0; }
.map-nodes { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-node { position: absolute; border-radius: 50%; border-width: 2px; border-color: rgba(200, 230, 255, 0.6); }
.map-node:hover { border-color: rgb(255, 255, 255); }
.map-node-planet { border-color: rgba(220, 240, 255, 0.8); }
.map-node-moon { border-color: rgba(200, 200, 210, 0.7); }
.map-node-station { border-radius: 2px; background-color: rgb(80, 220, 255); }
.map-node-field { border-radius: 30%; background-color: rgb(230, 170, 70); }
.map-node-gate { background-color: rgba(0, 0, 0, 0); border-width: 4px; border-color: rgb(150, 170, 255); }
.map-node-here { border-width: 3px; border-color: rgb(90, 255, 140); }
.map-node-selected { border-width: 3px; border-color: rgb(255, 230, 120); }
.map-label { position: absolute; width: 180px; -unity-text-align: upper-center; font-size: 13px; color: rgb(210, 235, 245); }
.map-route { position: absolute; width: 16px; height: 16px; rotate: 45deg; background-color: rgba(170, 90, 255, 0.6); border-width: 2px; border-color: rgb(200, 130, 255); }
.map-info { position: absolute; right: 24px; top: 90px; width: 340px; padding: 16px; background-color: rgba(6, 18, 26, 0.95); border-width: 1px; border-color: rgb(60, 150, 190); }
.map-desc { font-size: 14px; color: rgb(185, 210, 220); white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.btn-route { margin-top: 12px; padding: 8px 14px; background-color: rgb(120, 60, 200); }

/* Icones padronizados (HUD e mapa) */
.icon { position: absolute; width: 16px; height: 16px; margin-left: -8px; margin-top: -8px; border-width: 2px; border-color: rgb(230, 230, 230); }
.icon-planet { border-radius: 50%; border-color: rgb(230, 235, 240); }
.icon-moon { width: 11px; height: 11px; margin-left: -6px; margin-top: -6px; border-radius: 50%; border-color: rgb(190, 190, 200); }
.icon-station { border-radius: 50%; border-color: rgb(80, 220, 255); }
.icon-asteroid { border-top-left-radius: 40%; border-top-right-radius: 65%; border-bottom-left-radius: 60%; border-bottom-right-radius: 30%; border-color: rgb(255, 190, 80); }
.icon-ship { border-radius: 0; border-color: rgb(225, 225, 235); }
.icon-pirate { border-radius: 0; border-color: rgb(255, 60, 50); }
.icon-gate { border-radius: 50%; border-color: rgb(150, 170, 255); }
.icon-field { border-width: 0; }
.icon-dollar { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-text-align: middle-center; font-size: 10px; padding: 0; margin: 0; color: rgb(80, 220, 255); -unity-font-style: bold; }
.icon-station > .icon-dollar { display: flex; }
.icon-inner { display: none; position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px; border-width: 2px; border-radius: 50%; border-color: rgb(150, 170, 255); }
.icon-gate > .icon-inner { display: flex; }
.icon-dot { display: none; position: absolute; width: 7px; height: 6px; margin-left: -3px; margin-top: -3px; border-width: 1.5px; border-color: rgb(255, 190, 80); border-top-left-radius: 40%; border-top-right-radius: 65%; border-bottom-left-radius: 60%; border-bottom-right-radius: 30%; }
.icon-field > .icon-dot { display: flex; }
.map-node.icon { margin-left: 0; margin-top: 0; }

/* Triangulo do alvo marcado */
.target-tri { position: absolute; width: 0; height: 0; margin-left: -9px; margin-top: -7px; border-left-width: 9px; border-right-width: 9px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); }
.tri-neutral { border-top-width: 14px; border-top-color: rgb(255, 255, 255); }
.tri-ally { border-top-width: 14px; border-top-color: rgb(80, 255, 120); }
.tri-enemy { border-bottom-width: 14px; border-bottom-color: rgb(255, 60, 50); }

/* Paineis do cockpit (3 embaixo + 2 em cima) */
.panel-title { -unity-text-align: middle-center; color: rgb(110, 220, 250); font-size: 24px; margin-top: 4px; margin-bottom: 6px; }
.panel-bar-label { font-size: 18px; color: rgb(170, 210, 225); margin-bottom: 2px; }
.panel-bar { height: 18px; width: 100%; margin-bottom: 8px; background-color: rgba(10, 30, 40, 0.9); border-width: 1px; border-color: rgba(120, 200, 230, 0.4); }
.panel-tabs { flex-direction: row; justify-content: space-between; margin-bottom: 6px; }
.panel-tab { flex-grow: 1; margin: 0 2px; padding: 4px 2px; font-size: 15px; background-color: rgba(30, 70, 90, 0.7); color: rgb(200, 235, 245); border-width: 0; }
.panel-tab-active { background-color: rgb(40, 150, 190); color: rgb(5, 15, 20); }
.panel-list { flex-grow: 1; }
.panel-feed { font-size: 16px; color: rgb(205, 230, 240); white-space: normal; margin-bottom: 3px; }
.panel-hostile { color: rgb(255, 80, 70); }
.panel-centered { justify-content: center; align-items: center; }
.panel-clock { font-size: 72px; color: rgb(150, 230, 255); -unity-font-style: bold; -unity-text-align: middle-center; }
.panel-ship-name { font-size: 48px; color: rgb(230, 250, 255); -unity-font-style: bold; -unity-text-align: middle-center; }
.panel-ship-sub { font-size: 20px; color: rgb(140, 190, 210); -unity-text-align: middle-center; }
.name-field { width: 260px; font-size: 15px; }

.notice { position: absolute; left: 0; right: 0; top: 44px; -unity-text-align: upper-center; font-size: 18px; color: rgb(20, 20, 20); background-color: rgba(255, 190, 60, 0.85); padding: 5px; }
.panel-notice { color: rgb(255, 190, 60); }
.panel-alert { color: rgb(255, 80, 70); font-size: 18px; }

.messages { position: absolute; left: 0; right: 0; top: 70px; align-items: center; }
.message { font-size: 16px; color: rgb(230, 245, 250); background-color: rgba(5, 20, 30, 0.5); padding: 4px 12px; margin-bottom: 4px; border-radius: 3px; }

/* Faixa inferior */
.bottom-center { position: absolute; left: 0; right: 0; bottom: 26px; align-items: center; }
.bottom-left { position: absolute; left: 28px; bottom: 26px; }
.bottom-right { position: absolute; right: 28px; bottom: 26px; align-items: flex-end; }
.slot { flex-direction: row; align-items: center; padding: 4px 10px; margin-top: 4px; background-color: rgba(10, 25, 35, 0.55); border-left-width: 3px; border-color: rgb(80, 200, 240); }
.slot-secondary { border-color: rgb(255, 150, 60); }

/* Mira e marcadores */
.reticle { position: absolute; width: 26px; height: 26px; margin-left: -13px; margin-top: -13px; border-width: 2px; border-radius: 13px; border-color: rgba(140, 230, 255, 0.85); }
.center-dot { position: absolute; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: rgba(140, 230, 255, 0.6); }
.marker { position: absolute; width: 14px; height: 14px; margin-left: -7px; margin-top: -7px; border-width: 2px; rotate: 45deg; }
.marker-label { position: absolute; font-size: 12px; margin-left: 12px; margin-top: -8px; }
.target-bracket { position: absolute; width: 44px; height: 44px; margin-left: -22px; margin-top: -22px; border-width: 2px; border-color: rgb(255, 210, 90); }
.arrow { position: absolute; width: 0; height: 0; margin-left: -8px; margin-top: -8px; border-left-width: 8px; border-right-width: 8px; border-bottom-width: 14px; border-left-color: rgba(0,0,0,0); border-right-color: rgba(0,0,0,0); }
.glass-arcs { position: absolute; width: 90px; margin-left: -45px; margin-top: 26px; }
.arc { height: 3px; margin-bottom: 3px; background-color: rgba(10, 20, 30, 0.4); }

/* Paineis do cockpit (renderizados em textura) */
.panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 14px; background-color: rgb(4, 16, 22); }
.panel-title { font-size: 20px; color: rgb(110, 220, 250); margin-bottom: 8px; }
.panel-row { flex-direction: row; justify-content: space-between; margin-bottom: 4px; }
.panel .label { font-size: 18px; }

/* Terminal da estacao */
.terminal { position: absolute; left: 8%; right: 8%; top: 8%; bottom: 8%; background-color: rgba(4, 14, 20, 0.94); border-width: 2px; border-color: rgb(60, 170, 210); padding: 22px; }
.terminal-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.terminal-tabs { flex-direction: row; margin-bottom: 12px; }
.tab { margin-right: 8px; padding: 6px 16px; background-color: rgba(30, 70, 90, 0.6); color: rgb(200, 235, 245); border-width: 0; }
.tab-active { background-color: rgb(40, 150, 190); color: rgb(5, 15, 20); }
.market-row { flex-direction: row; align-items: center; padding: 6px 4px; border-bottom-width: 1px; border-color: rgba(80, 160, 190, 0.25); }
.cell { width: 13%; font-size: 15px; color: rgb(200, 235, 245); }
.cell-wide { width: 18%; }
.btn { padding: 4px 12px; margin-left: 4px; background-color: rgb(30, 110, 140); color: rgb(230, 250, 255); border-width: 0; -unity-font-style: bold; }
.btn:hover { background-color: rgb(50, 160, 200); }
.btn:disabled { background-color: rgba(60, 70, 80, 0.6); color: rgb(120, 130, 140); }
.btn-launch { background-color: rgb(200, 120, 30); padding: 8px 22px; }
.cargo-bar { height: 12px; margin-top: 14px; background-color: rgba(10, 30, 40, 0.8); }
.cargo-fill { height: 100%; background-color: rgb(80, 200, 240); }
.qty { width: 60px; font-size: 15px; -unity-text-align: middle-center; color: rgb(230, 250, 255); }
